# Copy to .env and fill in the values before `make build && make up`.
# See README.md > Environment variables for what each one does.

SECRET_KEY=
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — POSTGRES_HOST must be `db` when running via docker compose
# (the service name), not `localhost`.
POSTGRES_DB=myapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Gemini provider
GEMINI_API_KEY=
GEMINI_AI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenRouter provider
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_EMBEDDING_MODEL=

# RAG
# Must match the output size of whichever embedding model you actually use.
DEFAULT_EMBEDDING_DIMENTIONS=1024
COSINE_DISTANCE_THRESHOLD=0.45
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual

# Celery — REDIS_HOST must be `redis` when running via docker compose.
CELERY_BROKER=redis://redis:6379/0
CELERY_BACKEND=redis://redis:6379/0
CELERY_TIMEZONE=America/Bogota
CELERY_TASK_TRACK_STARTED=True
CELERY_TASK_TIME_LIMIT=1800
